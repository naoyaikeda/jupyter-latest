Bootstrap: docker
From: alpine:latest

%files
    apps /apps

%post
    apk update
    apk upgrade
    apk add curl
    apk add git
{% if cookiecutter.rich_console == 'y' %}
    apk add bash
    apk add --no-cache starship
{% endif %}
    apk add --no-cache python3 py3-pip

    curl -LsSf https://astral.sh/uv/install.sh | sh

    cp /root/.local/bin/uv /usr/local/bin/uv
    chmod +x /usr/local/bin/uv

    chmod 777 /apps
    cd /apps

    uv init
    uv add jupyter notebook

{% if cookiecutter.rich_console == 'y' %}
%environment
    export SHELL=/bin/bash
{% endif %}
